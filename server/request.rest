### Register
POST http://localhost:3000/auth/register
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "password123"
}

### Login
# @name login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "password123"
}

### Google Sign-In
POST http://localhost:3000/auth/google
Content-Type: application/json

{
    "credential": "REPLACE_WITH_GOOGLE_ID_TOKEN"
}

### Refresh Token
POST http://localhost:3000/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{login.response.body.refreshToken}}"
}

### Logout
POST http://localhost:3000/auth/logout
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "refreshToken": "{{login.response.body.refreshToken}}"
}

### Get all recipes (paginated)
GET http://localhost:3000/recipes?page=1&limit=10

### Get recipe by ID
GET http://localhost:3000/recipes/REPLACE_WITH_VALID_ID

### Create a new recipe
# @name createRecipe
POST http://localhost:3000/recipes
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "title": "My Recipe Title",
    "description": "This is a recipe description",
    "image": "https://example.com/recipe.jpg",
    "ingredients": ["1 cup flour"],
    "instructions": ["Mix ingredients"],
    "cookTime": "25 min",
    "servings": 2,
    "difficulty": "Easy"
}

### Update a recipe
PUT http://localhost:3000/recipes/{{createRecipe.response.body._id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "title": "Updated Recipe Title",
    "description": "Updated recipe description"
}

### Delete a recipe
DELETE http://localhost:3000/recipes/{{createRecipe.response.body._id}}
Authorization: Bearer {{login.response.body.token}}

### Toggle like on a recipe
POST http://localhost:3000/recipes/{{createRecipe.response.body._id}}/like
Authorization: Bearer {{login.response.body.token}}

### Search recipes (AI-powered)
POST http://localhost:3000/recipes/search
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "query": "quick vegetarian pasta"
}

### Get my recipes
GET http://localhost:3000/recipes/me
Authorization: Bearer {{login.response.body.token}}

### Get recipe comments
GET http://localhost:3000/recipes/{{createRecipe.response.body._id}}/comments

### Create a recipe comment
POST http://localhost:3000/recipes/{{createRecipe.response.body._id}}/comments
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "text": "This looks delicious!"
}

### Get my profile
GET http://localhost:3000/users/profile
Authorization: Bearer {{login.response.body.token}}

### Update my profile
PUT http://localhost:3000/users/profile
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "name": "Updated Name",
    "bio": "Food lover",
    "website": "https://example.com",
    "location": "Tel Aviv, IL"
}

### Get user by ID (public profile)
GET http://localhost:3000/users/REPLACE_WITH_VALID_ID

### Update profile picture
PUT http://localhost:3000/users/profile/picture
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="profileImage"; filename="avatar.jpg"
Content-Type: image/jpeg

< ./path/to/avatar.jpg
--boundary--
