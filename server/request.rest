### Register
POST http://localhost:3000/auth/register
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "password123"
}

### Login
# @name login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "password123"
}

### Refresh Token
POST http://localhost:3000/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{login.response.body.refreshToken}}"
}

### Logout
POST http://localhost:3000/auth/logout
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "refreshToken": "{{login.response.body.refreshToken}}"
}

### Get all posts
GET http://localhost:3000/post

### Get posts by sender
GET http://localhost:3000/post?sender=REPLACE_WITH_SENDER_ID

### Get post by ID
GET http://localhost:3000/post/REPLACE_WITH_VALID_ID

### Create a new post
# @name createPost
POST http://localhost:3000/post
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "title": "My Post Title",
    "content": "This is content of my post"
}

### Update a post
PUT http://localhost:3000/post/{{createPost.response.body._id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "title": "Updated Post Title",
    "content": "Updated content"
}

### Delete a post
DELETE http://localhost:3000/post/{{createPost.response.body._id}}
Authorization: Bearer {{login.response.body.token}}

### Get all comments
GET http://localhost:3000/comments

### Get comments by post
GET http://localhost:3000/comments?postId=REPLACE_WITH_VALID_ID

### Get comment by ID
GET http://localhost:3000/comments/REPLACE_WITH_VALID_ID

### Create a new comment
# @name createComment
POST http://localhost:3000/comments
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "postId": "{{createPost.response.body._id}}",
    "message": "This is a comment"
}

### Update a comment
PUT http://localhost:3000/comments/{{createComment.response.body._id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "message": "Updated Comment Content"
}

### Delete a comment
DELETE http://localhost:3000/comments/{{createComment.response.body._id}}
Authorization: Bearer {{login.response.body.token}}

### Get all users
GET http://localhost:3000/users

### Get user by ID
GET http://localhost:3000/users/REPLACE_WITH_VALID_ID

### Delete a user
DELETE http://localhost:3000/users/REPLACE_WITH_VALID_ID
